#!/bin/bash
# Extract the real banner rotation for R34 s4 (aggregates only). CPU job.
#   qsub scripts/r34_schedule.pbs
#PBS -N r34_sched
#PBS -l select=1:ncpus=4:mem=64GB
#PBS -q short
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
source "$PBS_O_WORKDIR/env.sh"
export PYTHONUNBUFFERED=1
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
python scripts/extract_offer_schedule.py --out "$PBS_O_WORKDIR/results/r34/offer_schedule.json"
