#!/bin/bash
# ============================================================================
# R45 part B (scripts/r45_eval_chopped.py): frozen gen-6 checkpoints scoring
# chopped holdout histories. GPU by default; DEVICE=cpu for a test.
#
#   cd ~/ProductGPT/work_r45
#   qsub -v TAGS=<frozen R44 gen-6 tag>,SEEDS=1:2:3:4:5 scripts/r45_eval_chopped.pbs
#   qsub -q short -l select=1:ncpus=8:mem=48GB \
#        -v DEVICE=cpu,RUN_DIRS=<dir>,DEPTHS=0:1:2,OUT=results/r45/partB_test.json scripts/r45_eval_chopped.pbs
# Lists are colon-separated. Log: ~/ProductGPT/logs/r45_partB_<jobid>.log
# ============================================================================
#PBS -N r45_partB
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -q GPU
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg

set -o pipefail
module purge
module load python/3.11.4 cuda/12.5
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh" >/dev/null

DEVICE="${DEVICE:-cuda}"
OUT="${OUT:-results/r45/partB.json}"
[[ "$DEVICE" == "cpu" ]] && export CUDA_VISIBLE_DEVICES=""
log=/storage/home/jinmiao/ProductGPT/logs/r45_partB_${PBS_JOBID%%.*}.log
mkdir -p "$(dirname "$log")"
exec >"$log" 2>&1
echo "PBS job: $PBS_JOBID on $(hostname)  device=$DEVICE"
echo "Git:     $(git log --oneline -1)"

args=(--device "$DEVICE" --threads 8 --out "$OUT")
[[ -n "${RUN_DIRS:-}" ]] && args+=(--run-dirs ${RUN_DIRS//:/ })
[[ -n "${TAGS:-}" ]] && args+=(--tags ${TAGS//:/ })
[[ -n "${SEEDS:-}" ]] && args+=(--seeds ${SEEDS//:/ })
[[ -n "${DEPTHS:-}" ]] && args+=(--depths ${DEPTHS//:/ })
echo "Command: python scripts/r45_eval_chopped.py ${args[*]}"
python scripts/r45_eval_chopped.py "${args[@]}"
rc=$?
echo "exit=$rc"
exit $rc
