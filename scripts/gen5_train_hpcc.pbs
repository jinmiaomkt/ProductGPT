#!/bin/bash
# ============================================================================
# Train the gen-5 multi-stream state-space model on SMU HPCC.
#
# SUBMIT FROM THE REPO ROOT so $PBS_O_WORKDIR is the repo root:
#     cd ~/ProductGPT/ProductGPT
#     qsub scripts/gen5_train_hpcc.pbs
#
# Override settings without editing this file, using -v:
#     qsub -v MAX_EVENTS=768,EPOCHS=80 scripts/gen5_train_hpcc.pbs
#     qsub -v RESUME=1 scripts/gen5_train_hpcc.pbs        # continue a run
#
# Monitor:
#     qstat -u $USER              # queued / running
#     qstat -f <jobid>            # full detail incl. why it is queued
#     tail -f ~/ProductGPT/logs/gen5_train_<jobid>.log
#     qdel <jobid>                # cancel
#
# VERIFIED SITE FACTS (from `qstat -Q -f GPU` and `df -h`, Sep 2026):
#   - The GPU queue defines NO resources_max.walltime, so the 24h request
#     below is not capped by the queue.
#   - max_run_res.ngpus = [u:PBS_GENERIC=2]  ->  at most TWO GPUs running
#     per user at once. A third job queues. Plan sweeps in batches of 2.
#   - There is NO /storage/scratch/$USER on this cluster. Everything lives
#     under /storage/home. The filesystem had 14T free of 19T, so
#     checkpoint size is not a practical concern.
# ============================================================================

#PBS -N gen5_train
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -q GPU
#PBS -l walltime=24:00:00
#PBS -j oe

# Mail on Abort and End (not Begin -- a queued job starting is not news).
# This is push, not poll: it does not depend on a laptop being awake, on the
# VPN, or on any session being open, so it is the one status channel that
# keeps working overnight.
#PBS -m ae
# Without -M, PBS mails the local account on the cluster, which goes nowhere
# useful.
#PBS -M jinmiao@smu.edu.sg

set -eo pipefail

# ---------------------------------------------------------------- modules
module purge
module load python/3.11.4 cuda/12.5

cd "$PBS_O_WORKDIR"

# Reuses the eval venv: gen 5 needs torch, pandas, numpy, scikit-learn and
# openpyxl, all of which that venv already has. It deliberately does NOT need
# deepspeed -- train5_multistream.py is plain PyTorch, which is also why the
# same script runs on the Windows laptop.
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate

# ---------------------------------------------------------------- env
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}

# paths.py resolves every data path from this. Required.
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data

# Puts gen5_multistream/, shared/, the repo root etc. on PYTHONPATH so the
# bare-module imports resolve.
source "$PBS_O_WORKDIR/env.sh"

# ---------------------------------------------------------------- knobs
# Defaults here; override any of them at submit time with -v NAME=value.
PROFILE="${PROFILE:-hpcc}"
MAX_EVENTS="${MAX_EVENTS:-1024}"   # was 512; that default silently shrank 40755-58 (R11)
EPOCHS="${EPOCHS:-60}"
BATCH_SIZE="${BATCH_SIZE:-4}"
MAX_USERS="${MAX_USERS:-}"          # empty = all users
DATA_FILE="${DATA_FILE:-}"          # empty = whatever config5 defaults to
RESUME="${RESUME:-0}"

# Regularisation sweep knobs. Empty/0 means "leave the config default".
#   USER_EMB=0   drop the per-user embedding (memorisation capacity that is
#                a constant at eval time, since val/test users are unseen)
#   AUGMENT=1    permute obtained-product slots within each event
#   DROPOUT=0.25 override dropout
#   PATIENCE=10  override early-stopping patience
#   TAG=noemb    suffix for the run directory, so variants do not overwrite
#                each other's checkpoints
USER_EMB="${USER_EMB:-}"
AUGMENT="${AUGMENT:-}"
DROPOUT="${DROPOUT:-}"
PATIENCE="${PATIENCE:-}"
TAG="${TAG:-}"
#   MIX_HEADS=8  per-customer mixture over H output projections
#                (Lu & Kannan). 0 = single shared projection.
#   SPLIT=both   user | temporal | both. Default comes from config5.
MIX_HEADS="${MIX_HEADS:-}"
SPLIT="${SPLIT:-}"
#   TRACK_HOLDOUT=1  DIAGNOSTIC: score the holdout cells every epoch and
#                    record them in history.json. Never used for selection.
#                    Pair it with a large PATIENCE so the full curve is
#                    visible instead of stopping at the validation optimum.
TRACK_HOLDOUT="${TRACK_HOLDOUT:-}"
#   SEED=1          training seed (init + data order); the customer partition
#                   is fixed by split_seed, so seeds share one partition
#   VAL_MODE=late   validate on the late calibration campaigns (see R13)
#   VAL_FROM=27     first campaign of that late block
#   ARCH=gru        transformer | gru | lstm
SEED="${SEED:-}"
VAL_MODE="${VAL_MODE:-}"
VAL_FROM="${VAL_FROM:-}"
ARCH="${ARCH:-}"
#   ENCODER=gru     sequence encoder inside gen-5 (keeps cross-attn + inventory GRU)
#   CROSS_ATTN=0    drop the offer-inventory cross-attention
#   ALIBI=1         recency bias in the attention stack
#   PROD_ID=0       products by attributes only, no identity embedding
ENCODER="${ENCODER:-}"
CROSS_ATTN="${CROSS_ATTN:-}"
ALIBI="${ALIBI:-}"
PROD_ID="${PROD_ID:-}"

# Stop cleanly ~30 min before the 24h walltime so last.pt is written and the
# job can be resubmitted with RESUME=1 instead of losing the run.
TIME_BUDGET_MIN="${TIME_BUDGET_MIN:-1410}"

job_tag="${PBS_JOBID%%.*}"
log_dir=/storage/home/jinmiao/ProductGPT/logs
mkdir -p "$log_dir"

# Checkpoints must NOT go in the data dir. Keep a STABLE directory per
# configuration (not per job id) so a resubmitted job finds its own last.pt.
run_id="gen5_${PROFILE}_S${MAX_EVENTS}_b${BATCH_SIZE}${TAG:+_$TAG}"
output_dir="/storage/home/jinmiao/ProductGPT/runs/${run_id}"
mkdir -p "$output_dir"
export PRODUCTGPT_OUTPUT="$output_dir"

job_log="$log_dir/gen5_train_${job_tag}.log"
exec >"$job_log" 2>&1

# ---------------------------------------------------------------- notify
# Telegram push on exit, success or failure. Set up ~/.telegram_env on OMEGA
# to enable it; without that file this is a silent no-op and the job is
# unaffected. This fires even when `set -e` aborts the script, which plain
# trailing echoes do not.
#
# NOTE: outbound HTTPS is confirmed working from the LOGIN node. Compute nodes
# may sit behind a stricter policy -- the first job to run will tell us, and a
# blocked request costs nothing because notify.sh never fails its caller.
on_exit() {
  rc=$?
  local last
  last="$(grep -aE 'val_nll|epoch|Traceback|Error|OOM|Killed' "$job_log" 2>/dev/null | tail -n 1)"
  if [[ $rc -eq 0 ]]; then
    bash "$PBS_O_WORKDIR/scripts/notify.sh" \
      "OK  ${run_id} (job ${job_tag}) finished. ${last}" || true
  else
    bash "$PBS_O_WORKDIR/scripts/notify.sh" \
      "FAIL ${run_id} (job ${job_tag}) exit=${rc}. ${last}" || true
  fi
}
trap on_exit EXIT

# ---------------------------------------------------------------- banner
echo "Start time:  $(date --iso-8601=seconds)"
echo "PBS job:     $PBS_JOBID"
echo "Host:        $(hostname)"
echo "Work dir:    $PBS_O_WORKDIR"
echo "Run id:      $run_id"
echo "Output dir:  $output_dir"
echo "Python:      $(which python)"
python --version
nvidia-smi
echo

# ---------------------------------------------------------------- preflight
required_files=(
  "$PBS_O_WORKDIR/gen5_multistream/train5_multistream.py"
  "$PBS_O_WORKDIR/gen5_multistream/config5.py"
  "$PBS_O_WORKDIR/gen5_multistream/dataset_multistream.py"
  "$PBS_O_WORKDIR/gen5_multistream/model_multistream_state_space.py"
  "$PBS_O_WORKDIR/paths.py"
  "$PBS_O_WORKDIR/shared/features.py"
)
for f in "${required_files[@]}"; do
  [[ -f "$f" ]] || { echo "ERROR: missing required file: $f" >&2; exit 2; }
done

if [[ ! -d "${PRODUCTGPT_DATA:-}" ]]; then
  echo "ERROR: PRODUCTGPT_DATA unset or not a directory: '${PRODUCTGPT_DATA:-}'" >&2
  exit 2
fi
echo "PRODUCTGPT_DATA:   $PRODUCTGPT_DATA"
echo "PRODUCTGPT_OUTPUT: $PRODUCTGPT_OUTPUT"
ls -la "$PRODUCTGPT_DATA" | head -20
echo

# Fail fast if the job did not actually get a GPU, rather than silently
# training on CPU for 24 hours.
python - <<'PY'
import torch
print("PyTorch:", torch.__version__, "| CUDA runtime:", torch.version.cuda)
if not torch.cuda.is_available():
    raise SystemExit("ERROR: no usable CUDA device in this job")
p = torch.cuda.get_device_properties(0)
print(f"GPU: {p.name}  {p.total_memory/1024**3:.1f} GB  sm_{p.major}{p.minor}")
PY
echo

# ---------------------------------------------------------------- run
args=(
  --profile "$PROFILE"
  --max-events "$MAX_EVENTS"
  --epochs "$EPOCHS"
  --batch-size "$BATCH_SIZE"
  --time-budget-min "$TIME_BUDGET_MIN"
)
[[ -n "$MAX_USERS" ]] && args+=(--max-users "$MAX_USERS")
[[ -n "$DATA_FILE" ]] && args+=(--data-file "$DATA_FILE")
[[ "$RESUME" == "1" ]] && args+=(--resume)
[[ "$USER_EMB" == "0" ]] && args+=(--no-user-embedding)
[[ "$AUGMENT" == "1" ]] && args+=(--augment)
[[ -n "$DROPOUT" ]] && args+=(--dropout "$DROPOUT")
[[ -n "$PATIENCE" ]] && args+=(--patience "$PATIENCE")
[[ -n "$MIX_HEADS" ]] && args+=(--mix-heads "$MIX_HEADS")
[[ -n "$SPLIT" ]] && args+=(--split-mode "$SPLIT")
[[ "$TRACK_HOLDOUT" == "1" ]] && args+=(--track-holdout)
[[ -n "$SEED" ]] && args+=(--seed "$SEED")
[[ -n "$VAL_MODE" ]] && args+=(--val-mode "$VAL_MODE")
[[ -n "$VAL_FROM" ]] && args+=(--val-from "$VAL_FROM")
[[ -n "$ARCH" ]] && args+=(--arch "$ARCH")
[[ -n "$ENCODER" ]] && args+=(--encoder "$ENCODER")
[[ "$CROSS_ATTN" == "0" ]] && args+=(--no-cross-attn)
[[ "$ALIBI" == "1" ]] && args+=(--alibi)
[[ "$PROD_ID" == "0" ]] && args+=(--no-product-id)

echo "Command: python gen5_multistream/train5_multistream.py ${args[*]}"
echo
python gen5_multistream/train5_multistream.py "${args[@]}"

echo
echo "Finish time: $(date --iso-8601=seconds)"
echo "Artifacts in $output_dir:"
ls -la "$output_dir"
