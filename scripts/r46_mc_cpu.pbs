#!/bin/bash
# ============================================================================
# R46 G3 follow-up, CPU array: Monte Carlo coverage of the sandwich SEs.
# 20 panels per rung from one fixed parameter vector, all in parallel.
#     qsub -J 0-79 scripts/r46_mc_cpu.pbs      # R1b, R3, R5, R6 (K=2) x 20
# Then:  python scripts/r46_mc_coverage.py --aggregate $MC/<rung>
# Log: ~/ProductGPT/logs/r46_mc_<array id>_<index>.log
# ============================================================================
#PBS -N r46_mc
#PBS -l select=1:ncpus=4:mem=16GB
#PBS -q short
#PBS -l walltime=06:00:00
#PBS -j oe

set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

MC="${MC:-/storage/home/jinmiao/ProductGPT/runs/r46_mc}"
IDX="${PBS_ARRAY_INDEX:-0}"
RUNGS=(R1b R3 R5 R6)
RUNG=${RUNGS[$((IDX / 20))]}
REP=$((IDX % 20))
K=1
[ "$RUNG" = "R6" ] && K=2
JID="${PBS_JOBID%%.*}"
JID="${JID//[\[\]]/_}"
LOG=/storage/home/jinmiao/ProductGPT/logs/r46_mc_${JID}_${IDX}.log
exec > >(tee -a "$LOG") 2>&1
python scripts/r46_mc_coverage.py --rung "$RUNG" --K "$K" --N 800 --S 120 --rep "$REP" \
    --out-dir "$MC" --threads 4
