#!/bin/bash
# R47 part A: model-free forgetting curves (scripts/r47_partA_model_free.py), CPU.
#   cd ~/ProductGPT/work_r47 && qsub scripts/r47_partA.pbs
# Log: ~/ProductGPT/logs/r47_partA_<jobid>.log; results/r47/partA.json
#PBS -N r47_partA
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -q short
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
set -o pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=""
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh" >/dev/null
log=/storage/home/jinmiao/ProductGPT/logs/r47_partA_${PBS_JOBID%%.*}.log
mkdir -p "$(dirname "$log")"
exec >"$log" 2>&1
echo "PBS job: $PBS_JOBID on $(hostname)"
echo "Git:     $(git log --oneline -1)"
#   ROBUST=1: the days-into-campaign robustness version (results/r47/partA_robust.json)
if [[ "${ROBUST:-0}" == "1" ]]; then
  python scripts/r47_partA_model_free.py --strata-days 1 --out results/r47/partA_robust.json
else
  python scripts/r47_partA_model_free.py --out results/r47/partA.json
fi
rc=$?
echo "exit=$rc"
exit $rc
