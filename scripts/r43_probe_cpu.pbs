#!/bin/bash
# ============================================================================
# R43 step 0: the rollout probe on the gen-6 smoke checkpoint, on a CPU node.
#
#   cd ~/ProductGPT/work_gen6
#   qsub scripts/r43_probe_cpu.pbs
#   qsub -v RUN_DIR=/storage/home/jinmiao/ProductGPT/runs/<run> scripts/r43_probe_cpu.pbs
#
# Gates and their meaning: see scripts/r43_rollout_probe.py and EXPERIMENTS.md R43.
# Log: ~/ProductGPT/logs/r43_probe_<jobid>.log; results/r43/probe.json in the repo.
# ============================================================================
#PBS -N r43_probe
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -q short
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg

set -o pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export CUDA_VISIBLE_DEVICES=""
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

RUN_DIR="${RUN_DIR:-/storage/home/jinmiao/ProductGPT/runs/gen6_hpcc_W384_C512_b4_g6smoke_s1}"
log=/storage/home/jinmiao/ProductGPT/logs/r43_probe_${PBS_JOBID%%.*}.log
mkdir -p "$(dirname "$log")"
exec >"$log" 2>&1

echo "PBS job: $PBS_JOBID on $(hostname)"
echo "Git:     $(git log --oneline -1)"
echo "Run dir: $RUN_DIR"
python scripts/r43_rollout_probe.py --run-dir "$RUN_DIR" --threads 4
rc=$?
echo "exit=$rc"
exit $rc
