#!/bin/bash
#PBS -N r54_score
#PBS -l select=1:ncpus=8:ngpus=2:mem=64GB
#PBS -q GPU
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
# ============================================================================
# R54, GPU: one arm on one shard of the out-of-sample customers.
#   ARM=a   Muse Glimmer 30B  productgpt-llm5,  bf16, its own chat format
#   ARM=b   Gemma 4 31B       productgpt-llm5,  bf16, its own chat format
#   ARM=c   Centaur           productgpt-llm70, 4-bit base + LoRA, "You press <<X>>."
#   ARM=c0  Llama 3.1 70B     productgpt-llm70, 4-bit base alone, the same text, on
#                             R50's sample of 250 customers (NSHARDS=1)
# Weights split over the job's two L40S.  Every job gates itself before scoring and
# stops at the first failure:
#   1. the unit tests with the downloaded tokenizer (CPU, about a minute)
#   2. --strict-load: no weight missing or mis-shaped (and every adapter weight)
#   3. --selfcheck: T3/T4 with the real model on the GPU (SELFCHECK_TOL: Amendment 1, arm B only)
#   4. --memcheck: one pass on a synthetic customer longer than any real one
# CHECKS=1 stops there: no customer is scored (Centaur's load test).
#
#     cd ~/ProductGPT/work_r54
#     qsub -v ARM=a,SHARD=0,NSHARDS=4 scripts/r54_score_gpu.pbs     (etc.)
#
# Writes $R54/<tag>_out_shard<k>.npz/.json; a finished shard is skipped.
# ============================================================================
set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8 HF_HUB_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

: "${ARM:?pass ARM=a|b|c|c0}" "${SHARD:?pass SHARD}" "${NSHARDS:?pass NSHARDS}"
WHO="${WHO:-out}"
ROOT=/storage/home/jinmiao/ProductGPT
BASE70=Meta-Llama-3.1-70B-bnb-4bit
ADAPTER=$ROOT/models/Llama-3.1-Centaur-70B-adapter
case "$ARM" in
    a)  M=Muse-Glimmer-30B; VENV=productgpt-llm5;  TAG=muse_glimmer_30b; TARCH=glimmer; FORMAT=glimmer
        FLAGS="--auto-class image" ;;
    b)  M=gemma-4-31B-it;   VENV=productgpt-llm5;  TAG=gemma4_31b;       TARCH=gemma4;  FORMAT=gemma4
        FLAGS="" ;;
    c)  M=$BASE70;          VENV=productgpt-llm70; TAG=centaur_70b;      TARCH=llama;   FORMAT=press
        FLAGS="--adapter $ADAPTER" ;;
    c0) M=$BASE70;          VENV=productgpt-llm70; TAG=llama31_70b;      TARCH=llama;   FORMAT=press
        FLAGS="--sample 250 --sample-seed 50" ;;
    *)  echo "ARM must be a, b, c or c0"; exit 2 ;;
esac
[ -z "${CHECKS:-}" ] || FLAGS="$FLAGS --checks-only"
source "$ROOT/venvs/$VENV/bin/activate"
R46=$ROOT/runs/r46
R54=$ROOT/runs/r54
mkdir -p "$R54"
LOG=$ROOT/logs/r54_score_${TAG}_${WHO}_s${SHARD}_${PBS_JOBID%%.*}.log
exec > >(tee -a "$LOG") 2>&1
echo "R54 score ARM=$ARM ($M) WHO=$WHO SHARD=$SHARD/$NSHARDS FLAGS=[$FLAGS] on $(hostname) at $(date), commit $(git rev-parse --short HEAD)"
cat "$ROOT/models/$M/REVISION.txt"
[ "$ARM" != c ] || cat "$ADAPTER/REVISION.txt"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

set +e
python scripts/test_r48_zeroshot.py --tokenizer "$ROOT/models/$M" --arch "$TARCH" --format "$FORMAT"
rc=$?
if [ $rc -eq 0 ]; then
    python -m llm_zeroshot.score --table "$R46/occasions_v6_S1024.npz" --model "$ROOT/models/$M" \
        --out-dir "$R54" --tag ${TAG}_${WHO} --who "$WHO" --format "$FORMAT" $FLAGS \
        --shard "$SHARD" --n-shards "$NSHARDS" --yarn 0 --n-gpus 2 \
        --strict-load --selfcheck --selfcheck-tol "${SELFCHECK_TOL:-0.1}" --memcheck 38000 --device cuda
    rc=$?
fi
set -e
if [ $rc -eq 0 ]; then
    bash "$PBS_O_WORKDIR/scripts/notify.sh" "OK  R54 ${TAG} ${WHO} shard ${SHARD}/${NSHARDS} checks=${CHECKS:-0} (job ${PBS_JOBID%%.*})" || true
else
    bash "$PBS_O_WORKDIR/scripts/notify.sh" "FAIL R54 ${TAG} ${WHO} shard ${SHARD}/${NSHARDS} checks=${CHECKS:-0} exit=${rc} (job ${PBS_JOBID%%.*})" || true
fi
exit $rc
