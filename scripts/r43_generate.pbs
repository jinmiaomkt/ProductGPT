#!/bin/bash
# ============================================================================
# R43 step 2: generation, gen 6 against the frozen gen 5. One family per job.
# Pre-registered in EXPERIMENTS.md (R43 step 2). One GPU.
#
#   cd ~/ProductGPT/work_gen6
#   qsub -v FAMILY=g5 scripts/r43_generate.pbs
#   qsub -v FAMILY=g6 -l walltime=<from the probe> scripts/r43_generate.pbs
#
# Gates on the free CPU queue first (test suites and the smoke, no GPU):
#   qsub -q short -l select=1:ncpus=4:mem=32GB -l walltime=02:00:00 \
#        -v FAMILY=g6,SMOKE_ONLY=1 scripts/r43_generate.pbs
# Price the g6 job (GPU, after its smoke):
#   qsub -l walltime=01:00:00 -v FAMILY=g6,PROBE=1 scripts/r43_generate.pbs
#
# Stages:
#   0  gates   test_rollout_fixes.py, test_seq_metrics.py, test_gen6_streaming.py,
#              then the family's arms on 12 customers (--smoke)
#   1  step 2  the family's arms on 300 customers x 8 replicates
#   2  price   (g5 only) teacher-forced NLL of G5 c06 s1 at context 384 and 1024
#              on the same 300 customers
#
# Log: ~/ProductGPT/logs/r43gen_<family>_<jobid>.log
# Results: results/r43/step2_<family>.json and _functionals.npz in the worktree.
# Then, once both jobs are done: python scripts/r43_step2_read.py
# ============================================================================
#PBS -N r43_generate
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -q GPU
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg

set -o pipefail
module purge
module load python/3.11.4 cuda/12.5
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=${NCPUS:-8}
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

fam=${FAMILY:?set FAMILY=g5 or g6}
jid=${PBS_JOBID%%.*}
log=/storage/home/jinmiao/ProductGPT/logs/r43gen_${fam}_${jid}.log
mkdir -p "$(dirname "$log")"
exec >"$log" 2>&1

echo "PBS job: $PBS_JOBID on $(hostname)   start $(date --iso-8601=seconds)"
echo "Dir:     $PBS_O_WORKDIR"
echo "Git:     $(git log --oneline -1)"
echo "Family:  $fam   SMOKE_ONLY=${SMOKE_ONLY:-0}   PROBE=${PROBE:-0}"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "no GPU"
python -c "import torch, numpy, sklearn; print('torch', torch.__version__, 'numpy', numpy.__version__, 'sklearn', sklearn.__version__, 'cuda', torch.cuda.is_available())"

finish() {
  echo
  echo "Finish: $(date --iso-8601=seconds)   $1"
  bash scripts/notify.sh "r43gen ${fam} ${jid}: $1" || true
  exit "$2"
}

if [[ "${PROBE:-0}" == "1" ]]; then
  echo
  echo "===== probe: the g6 rollouts' cost"
  python scripts/r43_generate.py --family "$fam" --probe
  rc=$?
  finish "probe exit $rc" "$rc"
fi

# ---------------------------------------------------------------- stage 0
for t in scripts/test_rollout_fixes.py scripts/test_seq_metrics.py scripts/test_gen6_streaming.py; do
  echo
  echo "===== gate: $t"
  python -W ignore "$t"
  rc=$?
  echo "===== gate: $t exit $rc"
  [[ $rc -eq 0 ]] || finish "STOPPED at gate $t (exit $rc)" 3
done

echo
echo "===== gate: smoke, the $fam arms on 12 customers"
python scripts/r43_generate.py --family "$fam" --smoke
rc=$?
echo "===== gate: smoke exit $rc"
[[ $rc -eq 0 ]] || finish "STOPPED at the smoke gate (exit $rc)" 4
[[ "${SMOKE_ONLY:-0}" == "1" ]] && finish "smoke-only run: every gate passed" 0

# ---------------------------------------------------------------- stage 1
echo
echo "===== stage 1: R43 step 2, family $fam"
python scripts/r43_generate.py --family "$fam"
rc1=$?
echo "===== stage 1 exit $rc1"

# ---------------------------------------------------------------- stage 2
rc2a=0; rc2b=0
if [[ "$fam" == "g5" ]]; then
  echo
  echo "===== stage 2: teacher-forced NLL, G5 c06 s1, context 384 then 1024"
  python scripts/r36c_generate.py --configs b40_g5_c06 --seeds 1 --tf-nll --max-events 384
  rc2a=$?
  python scripts/r36c_generate.py --configs b40_g5_c06 --seeds 1 --tf-nll --chunk 4
  rc2b=$?
  echo "===== stage 2 exit $rc2a / $rc2b"
fi

if [[ $rc1 -eq 0 && $rc2a -eq 0 && $rc2b -eq 0 ]]; then
  finish "done, all stages exit 0; read the log before quoting anything" 0
fi
finish "stage 1 exit $rc1, stage 2 exit $rc2a/$rc2b; read the log" 1
