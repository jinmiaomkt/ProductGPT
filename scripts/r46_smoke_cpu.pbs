#!/bin/bash
# ============================================================================
# R46 wiring smoke, CPU, one job: the first 300 customers through every step
# of part A (export, features, G2, M1 with the G3a check, R1b, R5 with SEs,
# R6 K=2 warm-started from R5, compare). Numbers mean nothing; G1 is not
# checked on a subset. Submit with SMOKE=1 bash scripts/submit_r46a.sh.
# ============================================================================
#PBS -N r46_smoke
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -q short
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg

set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8 NCPUS=8
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

R46="${R46:-/storage/home/jinmiao/ProductGPT/runs/r46_smoke}"
mkdir -p "$R46"
LOG=/storage/home/jinmiao/ProductGPT/logs/r46_smoke_${PBS_JOBID%%.*}.log
exec > >(tee -a "$LOG") 2>&1
echo "R46 smoke on $(hostname) at $(date), commit $(git rev-parse --short HEAD)"

T="$R46/occasions_v6_S1024.npz"
F="$R46/features_v6_S1024.npz"
python scripts/test_r46_parametric.py --quick
python -m parametric.data --out "$T" --max-users 300
python -m parametric.state --table "$T" --out "$F"
python -m parametric.leakcheck --table "$T" --feats "$F" --out "$R46/g2_leakcheck.json"
C=(--table "$T" --feats "$F" --out-dir "$R46" --threads 8)
python -m parametric.fit "${C[@]}" --rung M1 --se
python -m parametric.fit "${C[@]}" --rung R1b --se
python -m parametric.fit "${C[@]}" --rung R5 --start 0 --se
python -m parametric.fit "${C[@]}" --rung R5 --start 1 --se
python -m parametric.fit "${C[@]}" --rung R6 --K 2 --start 0 --init-from "$R46/R5_s*/result.json"
python -m parametric.fit "${C[@]}" --rung R6 --K 2 --start 0 --theta-from "$R46/R6_K2_s0/result.json" --se
python -m parametric.compare --runs-dir "$R46" --cell outsample_users_holdout_period
echo "R46 smoke done at $(date)"
