#!/bin/bash
#PBS -N r54_gemma_fp32
#PBS -l select=1:ncpus=40:mem=220GB
#PBS -q short
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
# ============================================================================
# R54 Amendment 1, CPU: Gemma 4's real weights upcast to float32 (about 125 GB, too
# large for two L40S), the in-job self-check on its synthetic customer, under R50's
# reference gate (t3 true-letter mean <= 1e-3).  No customer is scored.
#
#     cd ~/ProductGPT/work_r54b && qsub scripts/r54_gemma_fp32_cpu.pbs
# ============================================================================
set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=40 HF_HUB_OFFLINE=1
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

ROOT=/storage/home/jinmiao/ProductGPT
M=gemma-4-31B-it
source "$ROOT/venvs/productgpt-llm5/bin/activate"
OUT=$ROOT/runs/r54/reference
mkdir -p "$OUT"
LOG=$ROOT/logs/r54_gemma_fp32_${PBS_JOBID%%.*}.log
exec > >(tee -a "$LOG") 2>&1
echo "R54 float32 reference ($M) on $(hostname) at $(date), commit $(git rev-parse --short HEAD)"
cat "$ROOT/models/$M/REVISION.txt"

set +e
python -m llm_zeroshot.score --table "$ROOT/runs/r46/occasions_v6_S1024.npz" --model "$ROOT/models/$M" \
    --out-dir "$OUT" --tag gemma4_31b_fp32 --who out --format gemma4 \
    --strict-load --selfcheck --selfcheck-tol 1e-3 --checks-only --dtype float32 --device cpu
rc=$?
set -e
if [ $rc -eq 0 ]; then
    bash "$PBS_O_WORKDIR/scripts/notify.sh" "OK  R54 Gemma float32 reference (job ${PBS_JOBID%%.*})" || true
else
    bash "$PBS_O_WORKDIR/scripts/notify.sh" "FAIL R54 Gemma float32 reference exit=${rc} (job ${PBS_JOBID%%.*})" || true
fi
exit $rc
