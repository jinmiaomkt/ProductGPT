#!/bin/bash
# Does the attention inventory nest Guadagni-Little and McAlister? CPU job.
#   qsub scripts/nesting_sim.pbs
#PBS -N nesting
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -q short
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-eval/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
python simulation/run_nesting_study.py
