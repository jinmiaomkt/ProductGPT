#!/bin/bash
#PBS -N r48_dryrun
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -q short
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -m ae
#PBS -M jinmiao@smu.edu.sg
# ============================================================================
# R48 step 2, CPU: the unit tests with the downloaded tokenizer, then a dry run
# that tokenises every transcript of the real occasion table WITHOUT the model
# weights and reports the token-length distribution (aggregates only).  The
# context-length rule in EXPERIMENTS.md R48 is applied to that distribution.
#
#     cd ~/ProductGPT/work_r48 && qsub scripts/r48_dryrun_cpu.pbs
# ============================================================================
set -eo pipefail
module purge
module load python/3.11.4
cd "$PBS_O_WORKDIR"
source /storage/home/jinmiao/ProductGPT/venvs/productgpt-llm/bin/activate
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8 CUDA_VISIBLE_DEVICES="" HF_HUB_OFFLINE=1
export PRODUCTGPT_DATA=/storage/home/jinmiao/ProductGPT/data
source "$PBS_O_WORKDIR/env.sh"

M=/storage/home/jinmiao/ProductGPT/models/Qwen3-8B
R46=/storage/home/jinmiao/ProductGPT/runs/r46
R48=/storage/home/jinmiao/ProductGPT/runs/r48
mkdir -p "$R48"
LOG=/storage/home/jinmiao/ProductGPT/logs/r48_dryrun_${PBS_JOBID%%.*}.log
exec > >(tee -a "$LOG") 2>&1
echo "R48 dry run on $(hostname) at $(date), commit $(git rev-parse --short HEAD)"

python scripts/test_r48_zeroshot.py --tokenizer "$M"
for WHO in out in; do
    python -m llm_zeroshot.score --table "$R46/occasions_v6_S1024.npz" --model "$M" \
        --out-dir "$R48" --tag qwen3_8b_${WHO} --who "$WHO" --dry-run
done
echo "R48 dry run done at $(date)"
bash "$PBS_O_WORKDIR/scripts/notify.sh" "R48 dry run finished (job ${PBS_JOBID%%.*})" || true
